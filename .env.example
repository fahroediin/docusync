APP_NAME="DocuSync - Document Management System"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Google Drive Service Account Configuration
GDRIVE_FOLDER_ID=your_shared_gdrive_folder_id_here
GDRIVE_CREDENTIALS_PATH=credentials.json

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=docusync-documents
# ELASTICSEARCH_API_KEY=your_optional_api_key

# SQLite Configuration
SQLITE_DB_PATH=storage/docusync.db

# WhatsApp Bot & File Restriction Settings
PROCESS_GROUP_MESSAGES=true
ALLOW_ALL_GROUPS=true
COMMA_SEPARATED_GROUP_IDS=120363040000000000@g.us

# Allowed file extensions & size limit (in Megabytes)
ALLOWED_FILE_EXTENSIONS=pdf,xls,xlsx,doc,docx
MAX_UPLOAD_SIZE_MB=50

# Admin Phone Numbers allowed to delete files (comma-separated with country code or WhatsApp ID, e.g. 6281568218009,61499737415766)
ADMIN_PHONE_NUMBERS=628xxxxx

# ── Profiling & PDF Catalog Settings ──
# ID Folder Google Drive yang berisi file PDF terstandarisasi (misal: "PT Perkasa Pilar Utama_20-Agustus-2026.pdf")
GDRIVE_SUMMARY_FOLDER_ID=your_pdf_catalog_folder_id_here

# ID atau URL Google Spreadsheet yang berisi database ringkasan/profiling perusahaan
# Contoh: 1jLfSYSk3ifYhwWDn1UhZ319RHVgpxsSzLmBzFIuW5pk
# Atau URL: https://docs.google.com/spreadsheets/d/1jLfSYSk3ifYhwWDn1UhZ319RHVgpxsSzLmBzFIuW5pk/edit?gid=592056559#gid=592056559
PROFILING_SPREADSHEET_ID=your_google_spreadsheet_id_here

# ID Tab / Sheet GID (misal: 592056559 untuk tab Summary_Profiling). Jika URL sudah berisi gid, ini opsional.
PROFILING_SPREADSHEET_GID=592056559

